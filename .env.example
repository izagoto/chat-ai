APP_NAME=Alder AI
HOST=127.0.0.1
PORT=8000

OLLAMA_BASE_URL=http://127.0.0.1:11434
# 3B fits ~8GB RAM. Use llama3.2:8b (or similar) if you have 16GB+.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=llava
OLLAMA_TIMEOUT_SECONDS=180

DATA_PATH=data
DOCUMENTS_PATH=data/documents
DOCS_PATH=docs
DATABASE_URL=sqlite:///data/alder.db
RAG_TOP_K=5
RAG_USE_EMBEDDINGS=true
RAG_EMBED_MIN_SCORE=0.55
RAG_KEYWORD_MIN_SCORE=0.05
VIDEO_FRAME_INTERVAL_SEC=5
VIDEO_MAX_FRAMES=20
SESSION_MAX_TURNS=12
DEFAULT_COLLECTION=default
MAX_UPLOAD_BYTES=26214400
URL_FETCH_TIMEOUT_SECONDS=15
URL_MAX_BYTES=5242880

# Login (UI) — seed user dibuat otomatis jika DB kosong
AUTH_ENABLED=true
AUTH_EMAIL=user@alder.ai
AUTH_PASSWORD=Alder@2026
AUTH_DISPLAY_NAME=User
AUTH_SECRET=change-this-secret

LOCAL_API_KEY=
DEFAULT_SAFETY_MODE=normal
